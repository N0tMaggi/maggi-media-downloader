{
  "manifest_version": 3,
  "name": "maggi.dev tiktok downloader",
  "version": "2.0.0",
  "description": "TikTok downloader extension with preview-first popup and configurable defaults.",
  "icons": {
    "128": "assets/safe.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://api.maggi.dev/*"
  ],
  "background": {
    "service_worker": "src/background/main.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "assets/safe.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.tiktok.com/*"
      ],
      "js": [
        "src/content/main.ts"
      ],
      "run_at": "document_idle"
    }
  ]
}

